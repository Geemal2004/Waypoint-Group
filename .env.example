# Local development only; replace credentials before public deployment.
POSTGRES_DB=waypoint
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint_local_only
WEB_PORT=8080
CORE_PORT=8081
PLANNING_PORT=8000
OSRM_PORT=5000
FRESH_ONLY_REEFERS=true
# Declared supplemental judge reload / setpoint-change allowance.
